{
  "name": "free-search-mcp",
  "version": "0.1.0",
  "description": "Local-first, key-free MCP server for web search, page fetching and document parsing. Multi-engine with RRF fusion, SQLite FTS5 cache, Markdown-first output.",
  "license": "MIT",
  "author": "sweetcornna",
  "type": "module",
  "bin": {
    "free-search-mcp": "dist/cli.js",
    "fsmcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node dist/cli.js doctor",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "web-search",
    "search",
    "research",
    "web-scraping",
    "readability",
    "markdown",
    "sqlite",
    "fts5",
    "rrf",
    "local-first",
    "no-api-key",
    "claude",
    "cursor",
    "codex",
    "ollama",
    "llm",
    "agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^7.16.0",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweetcornna/free-search-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sweetcornna/free-search-mcp/issues"
  },
  "homepage": "https://github.com/sweetcornna/free-search-mcp#readme"
}
