# free-search-mcp configuration
#
# Every setting here is optional: the server works with no configuration at all
# using the keyless engines (DuckDuckGo, Mojeek, Google News).
#
# Copy this file to ~/.free-search-mcp/.env to apply it globally, or paste the
# variables you need into your MCP client's "env" block. Environment variables
# always win over this file, and this file wins over config.json.
#
# Every FREE_SEARCH_* variable also has a short FSMCP_* alias.

# ---------------------------------------------------------------------------
# Engines
# ---------------------------------------------------------------------------

# Comma-separated engine ids, or "auto" (the default) for the tiered policy:
# primary -> fallback -> matching subject indexes. See `free-search-mcp engines`.
# Examples:
#   FREE_SEARCH_ENGINES=duckduckgo,mojeek,googlenews
#   FREE_SEARCH_ENGINES=bing,baidu                 # reachable on filtered networks
#   FREE_SEARCH_ENGINES=all                        # every configured engine
# FREE_SEARCH_ENGINES=auto

# Override the tiers individually.
# FREE_SEARCH_PRIMARY_ENGINES=duckduckgo,mojeek,googlenews
# FREE_SEARCH_FALLBACK_ENGINES=bing,baidu,sogou,so360

# Result counts and time budget.
# FREE_SEARCH_MAX_RESULTS=12
# FREE_SEARCH_PER_ENGINE=10
# FREE_SEARCH_TIMEOUT=15000
# FREE_SEARCH_RETRIES=1
# FREE_SEARCH_CONCURRENCY=6

# Circuit breaker: how many consecutive failures bench an engine, and for how
# long. Blocks and unreachable hosts are benched after a single failure
# regardless of this threshold; it governs softer failures (read timeouts, 5xx).
# FREE_SEARCH_ENGINE_FAILURES=3
# FREE_SEARCH_ENGINE_COOLDOWN_MS=600000

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# HTTP(S) proxy. Standard HTTPS_PROXY / HTTP_PROXY / ALL_PROXY are also read.
# Use "none" to force direct connections.
# FREE_SEARCH_PROXY=http://127.0.0.1:7890

# A fixed User-Agent instead of the rotating desktop pool.
# FREE_SEARCH_USER_AGENT=
# FREE_SEARCH_ROTATE_UA=1

# ---------------------------------------------------------------------------
# Local index
# ---------------------------------------------------------------------------

# Set to 0 to disable the local SQLite index entirely (no caching, no
# search_index tool, no persisted circuit-breaker state).
# FREE_SEARCH_CACHE=1

# How long a fetched page stays fresh, in hours, and where the data lives.
# FREE_SEARCH_CACHE_TTL_HOURS=24
# FREE_SEARCH_DATA_DIR=~/.free-search-mcp
# FREE_SEARCH_CACHE_FILE=cache.sqlite

# TTL for cached raw engine responses, in ms. Set to 0 to always re-query.
# FREE_SEARCH_SEARCH_CACHE_TTL_MS=900000

# ---------------------------------------------------------------------------
# Fetching behaviour
# ---------------------------------------------------------------------------

# Honour robots.txt for fetch_url (1) or ignore it (0).
# FREE_SEARCH_RESPECT_ROBOTS=1

# Allow fetch_url to reach loopback/private addresses. Off by default as an
# SSRF guard; only enable it if you deliberately want to read local services.
# FREE_SEARCH_ALLOW_PRIVATE=0

# FREE_SEARCH_SAFE_SEARCH=moderate        # off | moderate | strict
# FREE_SEARCH_REGION=us                   # or cn, de, ...
# FREE_SEARCH_LANGUAGE=en                 # or zh, ja, ...
# FREE_SEARCH_MAX_BYTES=5242880           # response size cap per fetch
# FREE_SEARCH_MAX_CHARS=120000            # Markdown characters returned
# FREE_SEARCH_MAX_REDIRECTS=8

# ---------------------------------------------------------------------------
# Ranking
# ---------------------------------------------------------------------------

# The RRF damping constant from the original Cormack et al. paper. Larger
# values flatten the influence of the very top ranks.
# FREE_SEARCH_RRF_K=60

# ---------------------------------------------------------------------------
# Optional API keys — each one unlocks a higher-quality engine.
# The server works without any of them.
# ---------------------------------------------------------------------------

# https://api-dashboard.search.brave.com/app/keys
# BRAVE_API_KEY=

# https://serper.dev/api-key  (Google results as JSON)
# SERPER_API_KEY=

# https://app.tavily.com/home  (search + extracted content + an answer)
# TAVILY_API_KEY=

# https://dashboard.exa.ai/api-keys  (semantic search)
# EXA_API_KEY=

# Google Programmable Search — needs BOTH values.
# https://developers.google.com/custom-search/v1/overview
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=

# Your own SearXNG instance. Accepts a comma-separated list; they are tried in
# order until one answers with JSON. Requires `format: json` to be enabled in
# the instance's settings.yml.
# SEARXNG_URL=https://searx.example.org

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

# silent | error | warn | info | debug
# Logs always go to stderr, never to stdout, so they cannot corrupt JSON-RPC.
# FREE_SEARCH_LOG_LEVEL=warn
